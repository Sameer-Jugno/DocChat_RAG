# Required — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_chat
QDRANT_IMAGE_COLLECTION=pdf_chat_images

# Faster local embedder (was BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_THREADS=0
EMBEDDING_PARALLEL=0

# CLIP image retrieval (text query → page/figure images)
IMAGE_INDEX_ENABLED=true
IMAGE_EMBEDDING_MODEL=Qdrant/clip-ViT-B-32-vision
CLIP_TEXT_EMBEDDING_MODEL=Qdrant/clip-ViT-B-32-text
IMAGE_TOP_K=2
IMAGE_MIN_SCORE=0.20
IMAGE_MAX_PAGES=80
IMAGE_MAX_FIGURES=40
CHAT_HISTORY_TURNS=6

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Chunking — larger = fewer vectors = faster ingest
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=5
MAX_PDF_MB=25
MAX_FILE_MB=25

# OCR for scanned / image PDFs (RapidOCR)
OCR_ENABLED=true
OCR_MIN_CHARS=40
OCR_DPI=200
OCR_EMBEDDED_IMAGES=true

